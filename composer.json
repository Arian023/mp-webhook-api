{
    "name": "arian/mp-webhook-api",
    "description": "Mercado Pago Point webhook processor — Slim 4",
    "type": "project",
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5",
        "caseyamcl/guzzle_retry_middleware": "^2.12",
        "catfan/medoo": "^2.4",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.8",
        "nesbot/carbon": "^3.8",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "slim/psr7": "^1.7",
        "slim/slim": "^4",
        "symfony/dotenv": "^7.4"
    },
    "require-dev": {
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.3",
        "robmorgan/phinx": "^0.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/rector --no-ansi",
            "vendor/bin/pint --config pint.json --dirty"
        ],
        "analyse": "vendor/bin/phpstan analyse --no-ansi",
        "test": [
            "@analyse",
            "@lint"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
