APP_ENV=development
# Set to false in production to hide error details
APP_DEBUG=true
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=3306
DB_NAME=mp_webhook
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Set to true only for development — skips HMAC signature validation when MP_WEBHOOK_SECRET is empty
SKIP_WEBHOOK_VALIDATION=false
